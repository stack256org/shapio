# ─────────────────────────────────────────────────────────────────────────────
# Shapio — Docker Compose environment
#
#   cp .env.docker.example .env
#   # edit APP_SECRET + NEXT_PUBLIC_APP_URL below, then:
#   docker compose up -d
#
# This is the DOCKER variant of .env.example. The only difference that matters
# is DATABASE_URL: inside Compose the database is reachable at the service
# hostname `postgres`, not `localhost`. Everything else is identical, and
# everything below except the three required values can instead be set from
# Admin → Integrations or the first-run setup wizard once the app is running —
# see docs/implementation/INTEGRATIONS.md.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────

# Pre-filled to match the bundled `postgres` service in docker-compose.yml.
# Using docker-compose.external-db.yml instead? Replace this with your own
# connection string (Neon, Supabase, RDS, …).
DATABASE_URL=postgresql://shapio:shapio@postgres:5432/shapio

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────

# Random secret used to sign sessions — generate with: openssl rand -base64 36
APP_SECRET=replace-with-at-least-32-random-characters

# Public URL of this instance (used in every email link). No trailing slash.
# MUST be the URL your users actually reach — not localhost — in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port 3000 already taken on the host? Set APP_PORT instead — never PORT, see
# the app service comments in docker-compose.yml for why.
# APP_PORT=8080

# ─────────────────────────────────────────────────────────────
# Everything else — SMTP, Google OAuth, S3/R2 file storage, the inbound email
# webhook secret — is OPTIONAL here and can instead be set from Admin →
# Integrations or the setup wizard once you're signed in. See
# .env.example for the full annotated list if you'd rather set these as env
# vars (CI, a secrets manager, Kubernetes) instead.
# ─────────────────────────────────────────────────────────────
