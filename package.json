{
  "name": "shapio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "concurrently -n next,worker -c blue,yellow \"next dev --turbopack\" \"tsx --watch scripts/worker.ts\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "docs:sync": "node scripts/sync-readme.mjs",
    "docs:check": "node scripts/sync-readme.mjs --check",
    "worker": "tsx --watch scripts/worker.ts",
    "worker:start": "tsx scripts/worker.ts",
    "db:local": "tsx scripts/dev-db.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:prod": "tsx scripts/migrate.ts",
    "db:reset": "tsx db/reset.ts --confirm && pnpm db:migrate",
    "make:admin": "tsx scripts/make-admin.ts",
    "collapse-boards": "tsx scripts/collapse-boards.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@floating-ui/react": "^0.26.28",
    "@headlessui/react": "^2.2.10",
    "@paralleldrive/cuid2": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/render": "^2.0.8",
    "better-auth": "^1.6.18",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "daisyui": "^5.7.14",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^1.21.0",
    "marked": "^18.0.5",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "pg-boss": "^12.19.1",
    "postgres": "^3.4.9",
    "quill": "^2.0.3",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-email": "^6.6.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3",
    "vitest": "^4.1.9"
  }
}
